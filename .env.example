# .env.example
NEXT_PUBLIC_SUPABASE_URL=sua_supabase_url_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_supabase_service_role_key_aqui
GEMINI_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=
OWNER_EMAIL=adrianonascimentu@gmail.com
CRON_SECRET=seu_cron_secret_aqui

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# CRM & Social Media Webhooks
CRM_WEBHOOK_SECRET=seu_segredo_webhook_aqui
SOCIAL_MEDIA_WEBHOOK_SECRET=seu_segredo_social_media_aqui

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=seu_vapid_public_key_aqui
VAPID_PRIVATE_KEY=seu_vapid_private_key_aqui
VAPID_SUBJECT=mailto:seu_email@exemplo.com

# Provedor de E-mails Transacionais / SMTP (Resend ou SendGrid para Supabase)
# Resend: Host=smtp.resend.com, Port=465 (SSL) / 587 (TLS), User=resend, Pass=re_...
# SendGrid: Host=smtp.sendgrid.net, Port=587, User=apikey, Pass=SG....
SMTP_PROVIDER=resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_sua_api_key_resend_aqui
SMTP_SENDER_EMAIL=contato@seudominio.com.br
SMTP_SENDER_NAME=Sua Empresa

